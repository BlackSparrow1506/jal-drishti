{
  "expo": {
    "name": "Jal Drishti",
    "slug": "jal-drishti",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teambluemoon.jaldrishti"
    },
    "android": {
      "package": "com.teambluemoon.jaldrishti",
      "adaptiveIcon": {
        "backgroundColor": "#12324A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jal Drishti uses your location to show your flood risk and the safest evacuation route."
        }
      ]
    ]
  }
}
